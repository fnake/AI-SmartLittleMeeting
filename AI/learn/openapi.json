{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Chat API (Flask + LangChain)",
    "description": "智谱 GLM 多话题聊天 API(Flask + LangChain)。身份模型: 先 POST /auth/guest 领游客凭证, 每台设备一个独立身份, 数据按凭证完全隔离; 注册时带 X-Guest-Token = 游客转正(user_id 不变, 历史数据无缝保留); 游客与账号数据相互独立: 游客就是游客, 登录后用的就是账号自己的数据。ID 规则: 话题/消息 id 从 1 自增; user_id 从 10000 自增(5位数)。游客态和登录态请求格式相同: 请求头 Token: <token>(7天有效, 直接放 token 值)。每次聊天自动向量化入库; /memory/search 按语义搜索当前身份自己的历史。",
    "version": "5.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "本地开发环境"
    }
  ],
  "tags": [
    {
      "name": "聊天",
      "description": "对话接口"
    },
    {
      "name": "话题",
      "description": "话题(会话记忆)管理"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "话题"
        ],
        "summary": "服务状态",
        "operationId": "getIndex",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/topics": {
      "get": {
        "tags": [
          "话题"
        ],
        "summary": "话题列表",
        "description": "返回当前登录用户的话题列表(按创建时间倒序)。未登录/退出登录后返回 401，不显示任何历史记录。",
        "operationId": "listTopics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "topics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Topic"
                      }
                    }
                  }
                },
                "example": {
                  "topics": [
                    {
                      "id": "a1b2c3d4",
                      "title": "新话题 1",
                      "created_at": "2026-10-21 19:00:00",
                      "message_count": 4
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效(退出登录后历史记录不可见)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "请先登录后查看历史记录"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "凭证: 游客 token 或登录 token, 直接写值"
          }
        ]
      },
      "post": {
        "tags": [
          "话题"
        ],
        "summary": "新建话题",
        "operationId": "createTopic",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "话题标题，不传自动命名",
                    "example": "Python 学习"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Topic"
                }
              }
            }
          }
        }
      }
    },
    "/topics/{topic_id}": {
      "delete": {
        "tags": [
          "话题"
        ],
        "summary": "删除话题",
        "description": "删除话题及其全部聊天记忆。",
        "operationId": "deleteTopic",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "a1b2c3d4"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "example": {
                  "ok": true
                }
              }
            }
          },
          "404": {
            "description": "话题不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "聊天"
        ],
        "summary": "聊天（一次性回复）",
        "description": "传 topic_id 在指定话题内对话（携带该话题历史记忆）；不传 topic_id 则自动新建话题，标题取消息前 20 字。",
        "operationId": "chatOnce",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "example": {
                "message": "你好，用一句话介绍你自己",
                "topic_id": "a1b2c3d4"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "回复成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reply": {
                      "type": "string",
                      "description": "模型回复"
                    },
                    "topic_id": {
                      "type": "string",
                      "description": "本次对话所属话题ID"
                    }
                  }
                },
                "example": {
                  "reply": "你好！我是AI小会……",
                  "topic_id": "a1b2c3d4"
                }
              }
            }
          },
          "400": {
            "description": "消息为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "topic_id 不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "模型调用失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat/stream": {
      "post": {
        "tags": [
          "聊天"
        ],
        "summary": "聊天（流式回复）",
        "description": "与 /chat 相同，响应为 text/plain 分段流式输出；新建话题时，话题ID通过响应头 X-Topic-Id 返回。",
        "operationId": "chatStream",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "流式纯文本回复，响应头含 X-Topic-Id",
            "headers": {
              "X-Topic-Id": {
                "description": "本次对话所属话题ID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "消息为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "topic_id 不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/memory/search": {
      "post": {
        "tags": [
          "话题"
        ],
        "summary": "语义搜索历史记忆",
        "description": "把查询文字向量化后与所有历史消息算余弦相似度，返回最相关的 top_k 条。传 user_id 则只在该用户的话题范围内搜索。",
        "operationId": "memorySearch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemorySearchRequest"
              },
              "example": {
                "query": "之前问过装饰器吗",
                "top_k": 5,
                "user_id": "guest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "搜索结果(按相似度倒序)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemoryHit"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "查询为空",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "向量化失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注册(手机号+密码); 带 X-Guest-Token 则游客转正",
        "operationId": "authRegister",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "phone": "13800138000",
                "password": "abc123456"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功。普通注册返回 {message: 注册成功，请登录}(需再登录); 带 X-Guest-Token 时返回 {message: 注册成功，历史数据已保留, user_id: 原游客ID}, 且无需重新登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "400": {
            "description": "手机号/密码不合法或已注册",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Guest-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "可选。带上时该游客\"转正\": user_id 不变, 名下话题/消息全部保留, is_guest 置 0, 原 token 继续有效"
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录(手机号+密码)",
        "operationId": "authLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "phone": "13800138000",
                "password": "abc123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回 token(7天有效)。单token模型: 同一账号只保留最新一个token, 重新登录会使旧token全部失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "该手机号未注册(提示请先注册) 或 手机号或密码错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注销 token",
        "operationId": "authLogout",
        "parameters": [
          {
            "name": "Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "凭证: 游客 token 或登录 token, 直接写值"
          }
        ],
        "responses": {
          "200": {
            "description": "已注销",
            "content": {
              "application/json": {
                "example": {
                  "ok": true
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "当前用户信息",
        "operationId": "authMe",
        "parameters": [
          {
            "name": "Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "凭证: 游客 token 或登录 token, 直接写值"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/guest": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "领取游客凭证(每台设备一个独立身份)",
        "operationId": "authGuest",
        "responses": {
          "201": {
            "description": "返回游客 token(7天有效), 前端保存后所有请求带 Token: <token>; 该游客名下的话题/消息与其他凭证完全隔离",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "message": "游客身份已创建",
                  "user_id": 10000,
                  "token": "e3b0c44298fc1c14...",
                  "expires_at": "2026-10-29 12:00:00"
                }
              }
            }
          }
        }
      }
    },
    "/topics/{topic_id}/messages": {
      "get": {
        "tags": [
          "话题"
        ],
        "summary": "话题的聊天记录",
        "description": "按时间正序全量返回某话题的全部消息，用于刷新/重启后回显历史。仅话题属主可见：请求头 Token: <token>，未登录返回 401，话题不存在或不属于当前身份返回 404。",
        "operationId": "listTopicMessages",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "topic": {
                      "$ref": "#/components/schemas/Topic"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Message"
                      },
                      "description": "按时间正序(旧→新)"
                    }
                  }
                },
                "example": {
                  "topic": {
                    "id": 10,
                    "title": "历史记录测试",
                    "created_at": "2026-10-27 10:00:00",
                    "user_id": 10000
                  },
                  "messages": [
                    {
                      "id": 1,
                      "role": "human",
                      "content": "你好，请记住我喜欢蓝色",
                      "created_at": "2026-10-27 10:00:00"
                    },
                    {
                      "id": 2,
                      "role": "ai",
                      "content": "好的，已记住你喜欢蓝色",
                      "created_at": "2026-10-27 10:00:05"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未登录/凭证无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "话题不存在或不属于当前身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Topic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "从1自增",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "话题标题",
            "example": "新话题 1"
          },
          "created_at": {
            "type": "string",
            "description": "创建时间",
            "example": "2026-10-21 19:00:00"
          },
          "message_count": {
            "type": "integer",
            "description": "消息条数(含问答双方)",
            "example": 4
          },
          "user_id": {
            "type": "integer",
            "description": "所属用户ID",
            "example": 10000
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "用户消息",
            "example": "你好"
          },
          "topic_id": {
            "type": "integer",
            "description": "话题ID, 不传自动新建",
            "example": 1
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "错误描述",
            "example": "话题不存在"
          },
          "topic_id": {
            "type": "string",
            "description": "相关话题ID(仅模型调用失败时)",
            "example": "a1b2c3d4"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "AI Chat API (Flask + LangChain)"
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "MemorySearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "查询内容",
            "example": "之前问过装饰器吗"
          },
          "top_k": {
            "type": "integer",
            "default": 5,
            "maximum": 20,
            "description": "返回条数"
          },
          "user_id": {
            "type": "string",
            "description": "用户ID，传了只搜该用户的记忆",
            "example": "guest"
          }
        }
      },
      "MemoryHit": {
        "type": "object",
        "properties": {
          "topic_id": {
            "type": "integer",
            "example": 1
          },
          "role": {
            "type": "string",
            "description": "human 或 ai",
            "example": "human"
          },
          "content": {
            "type": "string",
            "description": "原聊天内容",
            "example": "python 装饰器怎么用"
          },
          "score": {
            "type": "number",
            "description": "余弦相似度 0~1，越大越相关",
            "example": 0.8632
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "1开头的11位手机号",
            "example": "13800138000"
          },
          "password": {
            "type": "string",
            "description": "至少6位",
            "example": "abc123456"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "从10000自增",
            "example": 10000
          },
          "is_guest": {
            "type": "integer",
            "description": "1=游客身份, 0=正式用户",
            "example": 0
          },
          "phone": {
            "type": "string",
            "example": "13800138000"
          },
          "message": {
            "type": "string",
            "description": "提示语",
            "example": "注册成功，请登录"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "放入 Authorization: Bearer <token>"
          },
          "user_id": {
            "type": "integer",
            "example": 10000
          },
          "phone": {
            "type": "string",
            "example": "13800138000"
          },
          "expires_at": {
            "type": "string",
            "example": "2026-10-28 21:00:00"
          },
          "message": {
            "type": "string",
            "description": "提示语",
            "example": "登录成功"
          }
